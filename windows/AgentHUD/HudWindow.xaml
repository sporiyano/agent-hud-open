<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentHUD.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agent HUD">
    <Grid x:Name="Root" Background="#F21C1C1E" RequestedTheme="Dark" Padding="10,6,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Strip" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Height="22">
            <StackPanel x:Name="Marks" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
            <TextBlock x:Name="Summary" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E6FFFFFF" />
        </StackPanel>
        <StackPanel x:Name="Panel" Grid.Row="1" Spacing="4" Margin="2,8,2,2" Visibility="Collapsed" />
    </Grid>
</Window>
